# Copy to .env and fill in. Variables marked REQUIRED are checked at start-up when NODE_ENV=production.
# Never commit .env or any file with real values.

# --- Server -----------------------------------------------------------------
NODE_ENV=development          # set to production for a deployed server
PORT=3003                     # HTTP port

# --- Secrets (REQUIRED in production) ----------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=               # REQUIRED in production: signs the session cookie
JWT_SECRET=                   # REQUIRED in production: signs API bearer tokens

# --- Payments (Stripe) --------------------------------------------------------
# Optional outside production. Without STRIPE_SECRET_KEY the payment routes answer 503.
STRIPE_SECRET_KEY=            # REQUIRED in production for payments
STRIPE_PUBLISHABLE_KEY=       # sent to the storefront for Stripe.js
STRIPE_WEBHOOK_SECRET=        # REQUIRED in production: verifies Stripe webhooks

# --- Google sign-in (optional) -------------------------------------------------
# Google sign-in is switched on only when both client values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3003/api/auth/google/callback

# --- Initial admin account ----------------------------------------------------
# Used once, when the store has no admin yet. If the password is unset, a random one is generated and printed once.
COMMERCE_ADMIN_EMAIL=admin@ecommerce.com
COMMERCE_ADMIN_PASSWORD=

# --- Data -----------------------------------------------------------------------
# memory: data is lost on restart (development). file: data is kept in DATA_DIR, one folder per module.
DATA_PROVIDER=memory
DATA_DIR=./data/store
